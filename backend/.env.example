# ─────────────────────────────────────────────────────────────────────────────
# SMSFlow API (Laravel) - environment configuration
# Copy to .env and fill in. NEVER commit .env. Every value below is a placeholder.
# Production values go only into the server's .env (outside the web root).
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME="SMSFlow BD"
# production on the server; local on your machine
APP_ENV=production
# php artisan key:generate --show   (then paste here)
APP_KEY=
# MUST be false in production (errors are always generic on /api/*, but keep it off)
APP_DEBUG=false
# Public URL of this API (payment return/IPN URLs are built from it)
APP_URL=https://smsbackend.hivelabsbd.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# Next.js frontend origin(s): CORS allow-list (comma-separated) and links in emails (first one)
FRONTEND_URL=https://sms.hivelabsbd.com

# Only if a reverse proxy/CDN sits in front of PHP (e.g. Cloudflare, nginx): its IPs/CIDRs,
# comma-separated ("*" only when PHP is reachable exclusively through that proxy). Leave EMPTY when
# clients connect directly: trusting X-Forwarded-For then would let anyone spoof their IP and
# bypass per-IP rate limits and API-key IP allowlists.
# Production sits behind Cloudflare: set Cloudflare's published ranges
# (https://www.cloudflare.com/ips-v4 and /ips-v6) unless the host already restores the visitor IP
# in REMOTE_ADDR (UNVERIFIED for Hostinger — check what /internal/ready callers' IPs look like in logs).
TRUSTED_PROXIES=

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# production: warning (info logs every audit event and worker tick)
LOG_LEVEL=warning

# ── Database: the SAME MySQL/MariaDB database the Next.js app uses ───────────
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# Keep READ COMMITTED (the queue/wallet locking was designed for it)
DB_ISOLATION_LEVEL="READ COMMITTED"

# ── Laravel infrastructure ───────────────────────────────────────────────────
# API only: no server-side web sessions. NEVER "database" here: the `sessions` table belongs
# to the application's own login sessions.
SESSION_DRIVER=array
# database works on shared hosting; redis on a VPS with Redis installed
CACHE_STORE=database
QUEUE_CONNECTION=database
# Shared hosting without Supervisor: the scheduler drains the queue every minute.
# On a VPS with `php artisan queue:work` under Supervisor/systemd: false
QUEUE_WORKER_VIA_SCHEDULER=true
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Disk for sender ID documents (private; "local" = storage/app/private)
DOCUMENTS_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Shared application secrets ───────────────────────────────────────────────
# Must be IDENTICAL to the Next.js app's values while both run against the same database:
# existing API keys (HMAC pepper), phone OTPs and encrypted provider settings depend on them.
# Each at least 32 random characters, e.g.: openssl rand -base64 48
AUTH_SECRET=
API_KEY_PEPPER=
SETTINGS_ENCRYPTION_KEY=
# Protects /api/v1/internal/* (HTTP cron fallback, readiness probe)
CRON_SECRET=
# Shared ONLY with the Next.js server (same value as its FRONTEND_PROXY_SECRET), at least 32 chars.
# Lets Laravel trust the browser IP the Next.js server forwards in X-SMSFlow-Client-IP (login
# limits, audit/session IPs). Never expose it to the browser. Empty = forwarded IPs are ignored.
FRONTEND_PROXY_SECRET=

# ── Features ─────────────────────────────────────────────────────────────────
FEATURE_REGISTRATION_OPEN=true
FEATURE_PHONE_VERIFICATION=false
# Simulated checkout; staging only. NEVER true on the live site.
ALLOW_MOCK_PAYMENTS=false

# ── Email (queued; never blocks a request) ───────────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
SITE_LEGAL_NAME="SMSFlow BD (operating company name - configure)"
SITE_ADDRESS="Company address, Dhaka, Bangladesh (configure)"
SITE_SUPPORT_EMAIL=support@example.com
SITE_SALES_EMAIL=sales@example.com

# ── SMS provider (admin settings override these; mock = sends nothing) ──────
SMS_PROVIDER=http
SMS_PROVIDER_URL=
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_API_SECRET=
SMS_PROVIDER_WEBHOOK_SECRET=
SMS_PROVIDER_TIMEOUT=15
SMS_DEFAULT_SENDER_ID=8809600000000
# Send small API/campaign batches right after the HTTP response (the worker sends the rest)
SMS_INLINE_DISPATCH=true
SMS_WORKER_BATCH_SIZE=100
SMS_WORKER_MAX_BATCHES=20
SMS_WORKER_BUDGET_SECONDS=45

# ── Rate limits (per API key / per user, per minute) ────────────────────────
API_RATE_LIMIT_PER_MINUTE=600
API_SEND_RATE_LIMIT_PER_MINUTE=120
DASHBOARD_RATE_LIMIT_PER_MINUTE=300

# ── Payments (admin settings override these) ─────────────────────────────────
PAYMENT_PROVIDERS=manual
# SSLCommerz store id / password
PAYMENT_PROVIDER_KEY=
PAYMENT_PROVIDER_SECRET=
PAYMENT_PROVIDER_LIVE=false

# ── File storage (S3-compatible, optional) ───────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
