# ─────────────────────────────────────────────────────────────────────────────
# SMSFlow API (Laravel) - environment configuration
# Copy to .env and fill in. NEVER commit .env. Every value below is a placeholder.
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME=SMSFlow
# production on the server; local on your machine
APP_ENV=local
# php artisan key:generate
APP_KEY=
# MUST be false in production (true shows stack traces)
APP_DEBUG=true
# Public URL of this API, e.g. https://api.hivelabsbd.com
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# Next.js frontend origin(s) allowed by CORS, comma-separated (e.g. https://sms.hivelabsbd.com)
FRONTEND_URL=http://localhost:3000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# production: warning or error
LOG_LEVEL=debug

# ── Database: the SAME MySQL/MariaDB database the Next.js app uses ───────────
# Production (Hostinger): DB_HOST=localhost, DB_DATABASE=u211574503_smsflow, DB_USERNAME=u211574503_smsflow
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smsflow
DB_USERNAME=smsflow
DB_PASSWORD=
# Keep READ COMMITTED (the app's locking was designed for it)
DB_ISOLATION_LEVEL="READ COMMITTED"

# ── Laravel infrastructure ───────────────────────────────────────────────────
# API only: no server-side web sessions. Do NOT use "database" here: the `sessions` table
# belongs to the application's own login sessions.
SESSION_DRIVER=array
CACHE_STORE=database
# database works on shared hosting; redis on a VPS with Redis installed
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Shared application secrets ───────────────────────────────────────────────
# Must be IDENTICAL to the Next.js app's values while both run against the same database:
# existing API keys, OTPs and encrypted provider settings depend on them.
AUTH_SECRET=
API_KEY_PEPPER=
SETTINGS_ENCRYPTION_KEY=
# Protects internal/cron endpoints
CRON_SECRET=

# ── Email ────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── SMS provider (mock = sends nothing) ──────────────────────────────────────
SMS_PROVIDER=mock
SMS_PROVIDER_URL=
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_API_SECRET=
SMS_PROVIDER_WEBHOOK_SECRET=
SMS_DEFAULT_SENDER_ID=8809600000000

# ── File storage (S3-compatible) ─────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
