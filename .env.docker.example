# Configuration for docker-compose.yml. Create your own copy with random secrets:
#   sh docker/init-env.sh
# Never commit .env.docker. Avoid $ in values: Compose would try to expand it.

# Public URL of the panel. Baked into the build, so rebuild after changing it.
APP_URL=http://localhost:3000
APP_NAME="SMSFlow BD"
# Port the panel is published on, and the address it listens on.
WEB_PORT=3000
WEB_BIND=127.0.0.1
# For HTTPS with --profile tls: the domain, with APP_URL=https://<domain>. DNS must point here.
SITE_DOMAIN=

# ── Database ─────────────────────────────────────────────────────────────────
DB_DATABASE=smsflow
DB_USERNAME=smsflow
DB_PASSWORD=CHANGE_ME_HEX
DB_ROOT_PASSWORD=CHANGE_ME_HEX

# ── Secrets, shared by the panel and the API ────────────────────────────────
APP_KEY=CHANGE_ME_APP_KEY
AUTH_SECRET=CHANGE_ME_SECRET
API_KEY_PEPPER=CHANGE_ME_SECRET
SETTINGS_ENCRYPTION_KEY=CHANGE_ME_SECRET
FRONTEND_PROXY_SECRET=CHANGE_ME_SECRET
CRON_SECRET=CHANGE_ME_SECRET

# ── SMS ─────────────────────────────────────────────────────────────────────
# automas sends real SMS and needs the key and an approved sender ID. mock is refused in production.
SMS_PROVIDER=automas
SMS_PROVIDER_API_KEY=
SMS_DEFAULT_SENDER_ID=8809600000000
# What Automas charges per SMS (its Price List page), for the admin dashboard's message counts.
AUTOMAS_RATE_MASKING=0.50
AUTOMAS_RATE_NON_MASKING=0.22
SMS_PROVIDER_URL=
SMS_PROVIDER_API_SECRET=
SMS_PROVIDER_WEBHOOK_SECRET=

# ── Email ───────────────────────────────────────────────────────────────────
# log only writes emails to the container logs, so nobody can verify their address. Use smtp when live.
MAIL_MAILER=log
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="SMSFlow BD"

# ── Sign in with Google (both empty = button hidden) ────────────────────────
# Authorized redirect URI in Google Cloud: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Payments and features ───────────────────────────────────────────────────
PAYMENT_PROVIDERS=manual
ALLOW_MOCK_PAYMENTS=false
FEATURE_REGISTRATION_OPEN=true
FEATURE_PHONE_VERIFICATION=false
