{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start"
      ],
      "port": 3100,
      "autoPort": true
    },
    {
      "name": "api-local",
      "runtimeExecutable": "php",
      "runtimeArgs": ["backend/artisan", "serve", "--host=127.0.0.1", "--port=8001"],
      "port": 8001,
      "env": {
        "DB_DATABASE": "smsflow_api_test2",
        "SMS_PROVIDER": "mock",
        "PAYMENT_PROVIDERS": "manual",
        "QUEUE_CONNECTION": "sync",
        "FEATURE_DYNAMIC_SMS": "true",
        "FEATURE_MANUAL_TOPUPS": "true",
        "FEATURE_SENDER_CATALOG": "true",
        "FRONTEND_URL": "http://localhost:3220"
      }
    },
    {
      "name": "web-laravel",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "3220"],
      "port": 3220,
      "env": {
        "PORT": "3220",
        "APP_URL": "http://localhost:3220",
        "LARAVEL_API_URL": "http://127.0.0.1:8001",
        "LARAVEL_FEATURES": "all,dynamicSms,manualTopups,senderCatalog",
        "WORKER_IN_PROCESS": "false",
        "SMS_PROVIDER": "mock"
      }
    },
    {
      "name": "prod-deaddb",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start"],
      "port": 3230,
      "env": {
        "PORT": "3230",
        "APP_URL": "http://localhost:3230",
        "LARAVEL_API_URL": "http://127.0.0.1:8001",
        "LARAVEL_FEATURES": "all,dynamicSms,manualTopups,senderCatalog",
        "DATABASE_URL": "mysql://nobody@10.255.255.1:3306/unreachable",
        "WORKER_IN_PROCESS": "false",
        "SMS_PROVIDER": "mock"
      }
    },
    {
      "name": "admin-local",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start"
      ],
      "port": 3210,
      "env": {
        "PORT": "3210",
        "APP_URL": "http://localhost:3210",
        "DATABASE_URL": "mysql://root@127.0.0.1:3306/smsflow_cutover",
        "LARAVEL_API_URL": "http://127.0.0.1:8001",
        "LARAVEL_FEATURES": "all",
        "SMS_PROVIDER": "mock",
        "PAYMENT_PROVIDERS": "mock,manual"
      }
    }
  ]
}