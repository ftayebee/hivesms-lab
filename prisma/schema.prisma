// SMSFlow BD - relational schema (MySQL 8+ / MariaDB 10.4+)
//
// Conventions
// - UUID primary keys stored as CHAR(36) (safe to expose in URLs, not enumerable).
// - Every customer-owned row carries organizationId; all tenant queries filter on it.
// - Money is Decimal(14,4) in BDT. Never use floats for money.
// - deletedAt = soft delete for user-facing tenant data.
// - String defaults to VARCHAR(191): free text uses @db.Text, longer keys an explicit @db.VarChar.
// - String lists are Json arrays (MySQL has no array columns); read them with jsonStringArray().

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ─────────────────────────────── Enums ───────────────────────────────

enum PlatformRole {
  USER
  SUPPORT
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum MemberStatus {
  ACTIVE
  DISABLED
}

enum VerificationTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
  PHONE_OTP
}

enum SmsType {
  TRANSACTIONAL
  PROMOTIONAL
}

enum SenderType {
  MASKING
  NON_MASKING
}

enum SmsEncoding {
  GSM7
  UCS2
}

enum CampaignStatus {
  DRAFT
  PENDING_REVIEW
  SCHEDULED
  PROCESSING
  COMPLETED
  PAUSED
  CANCELLED
  FAILED
}

enum RecipientStatus {
  INCLUDED
  SKIPPED_SUPPRESSED
  SKIPPED_INVALID
  SKIPPED_DUPLICATE
  SKIPPED_BLOCKED
}

enum MessageStatus {
  QUEUED
  SUBMITTED
  DELIVERED
  FAILED
  REJECTED
  EXPIRED
  CANCELLED
}

enum MessageSource {
  API
  CAMPAIGN
  DASHBOARD
  SYSTEM
}

enum MessageEventSource {
  SYSTEM
  PROVIDER_WEBHOOK
  PROVIDER_POLL
  PROVIDER_RESPONSE
}

enum SenderIdStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ConsentStatus {
  OPTED_IN
  UNKNOWN
  OPTED_OUT
}

enum SuppressionReason {
  OPT_OUT
  MANUAL
  COMPLAINT
  INVALID
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
}

enum WalletTxType {
  CREDIT
  DEBIT
}

enum WalletTxReason {
  TOPUP
  BONUS
  SMS_CHARGE
  REFUND
  ADJUSTMENT
  SENDER_ID_FEE
}

enum PaymentStatus {
  PENDING
  AWAITING_VERIFICATION
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

enum InvoiceStatus {
  ISSUED
  PAID
  VOID
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ActorType {
  USER
  API_KEY
  SYSTEM
  ADMIN
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum InboundWebhookStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum BlocklistType {
  NUMBER
  KEYWORD
  URL_DOMAIN
}

enum AbuseReportStatus {
  NEW
  INVESTIGATING
  ACTIONED
  DISMISSED
}

enum LeadStatus {
  NEW
  CONTACTED
  CLOSED
}

// ─────────────────────────────── Identity ───────────────────────────────

model User {
  id                String       @id @default(uuid()) @db.Char(36)
  email             String       @unique @db.VarChar(254)
  phone             String?      @unique
  name              String       @db.VarChar(255)
  passwordHash      String
  platformRole      PlatformRole @default(USER)
  status            UserStatus   @default(ACTIVE)
  locale            String       @default("en")
  emailVerifiedAt   DateTime?
  phoneVerifiedAt   DateTime?
  failedLoginCount  Int          @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?

  sessions           Session[]
  verificationTokens VerificationToken[]
  memberships        OrganizationMember[]
  notifications      Notification[]
  notificationPrefs  NotificationPreference[]
  ticketMessages     SupportMessage[]
  createdTickets     SupportTicket[]          @relation("TicketCreator")
  assignedTickets    SupportTicket[]          @relation("TicketAssignee")
  auditLogs          AuditLog[]

  @@index([platformRole])
  @@map("users")
}

model Session {
  id                   String   @id @default(uuid()) @db.Char(36)
  tokenHash            String   @unique
  userId               String   @db.Char(36)
  activeOrganizationId String?  @db.Char(36)
  ipAddress            String?
  userAgent            String?  @db.Text
  expiresAt            DateTime
  lastSeenAt           DateTime @default(now())
  createdAt            DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model VerificationToken {
  id         String                @id @default(uuid()) @db.Char(36)
  userId     String                @db.Char(36)
  type       VerificationTokenType
  tokenHash  String                @unique
  target     String?               @db.VarChar(254) // email or phone the token was issued for
  attempts   Int                   @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime              @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("verification_tokens")
}

// ─────────────────────────────── Tenancy & RBAC ───────────────────────────────

model Organization {
  id                    String             @id @default(uuid()) @db.Char(36)
  name                  String             @db.VarChar(255)
  slug                  String             @unique
  status                OrganizationStatus @default(ACTIVE)
  suspendedReason       String?            @db.Text
  industry              String?
  website               String?            @db.VarChar(500)
  address               String?            @db.Text
  billingEmail          String?            @db.VarChar(254)
  taxId                 String? // e.g. BIN for VAT invoices
  country               String             @default("BD")
  timezone              String             @default("Asia/Dhaka")
  pricingPlanId         String?            @db.Char(36)
  // Anti-abuse controls
  dailySendLimit        Int                @default(1000)
  monthlySendLimit      Int                @default(20000)
  requireCampaignReview Boolean            @default(true)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  deletedAt             DateTime?

  pricingPlan        PricingPlan?         @relation(fields: [pricingPlanId], references: [id])
  members            OrganizationMember[]
  roles              Role[]
  invitations        Invitation[]
  contacts           Contact[]
  contactGroups      ContactGroup[]
  suppressionEntries SuppressionEntry[]
  campaigns          Campaign[]
  messages           Message[]
  templates          Template[]
  senderIds          SenderId[]
  apiKeys            ApiKey[]
  apiLogs            ApiLog[]
  idempotencyKeys    IdempotencyKey[]
  wallet             Wallet?
  walletTransactions WalletTransaction[]
  payments           Payment[]
  invoices           Invoice[]
  supportTickets     SupportTicket[]
  webhooks           WebhookEndpoint[]
  auditLogs          AuditLog[]
  notifications      Notification[]

  @@index([status])
  @@map("organizations")
}

model Permission {
  id          String @id @default(uuid()) @db.Char(36)
  key         String @unique
  group       String
  description String @db.Text

  roles RolePermission[]

  @@map("permissions")
}

model Role {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @db.Char(36)
  key            String // OWNER | ADMIN | MANAGER | DEVELOPER | VIEWER
  name           String
  description    String?  @db.Text
  isSystem       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  members      OrganizationMember[]
  invitations  Invitation[]

  @@unique([organizationId, key])
  @@map("roles")
}

model RolePermission {
  roleId       String @db.Char(36)
  permissionId String @db.Char(36)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model OrganizationMember {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @db.Char(36)
  userId         String       @db.Char(36)
  roleId         String       @db.Char(36)
  status         MemberStatus @default(ACTIVE)
  invitedById    String?      @db.Char(36)
  joinedAt       DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model Invitation {
  id             String    @id @default(uuid()) @db.Char(36)
  organizationId String    @db.Char(36)
  email          String    @db.VarChar(254)
  roleId         String    @db.Char(36)
  tokenHash      String    @unique
  invitedById    String    @db.Char(36)
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])

  @@index([organizationId, email])
  @@map("invitations")
}

// ─────────────────────────────── Contacts ───────────────────────────────

model Contact {
  id             String        @id @default(uuid()) @db.Char(36)
  organizationId String        @db.Char(36)
  name           String?       @db.VarChar(255)
  phone          String // E.164, e.g. +8801712345678
  email          String?       @db.VarChar(254)
  company        String?       @db.VarChar(255)
  tags           Json          @default("[]") // string[]
  customFields   Json          @default("{}")
  consentStatus  ConsentStatus @default(UNKNOWN)
  consentSource  String?       @db.VarChar(255)
  consentAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  groups       ContactGroupMember[]

  @@unique([organizationId, phone])
  @@index([organizationId, createdAt])
  @@index([organizationId, consentStatus])
  @@map("contacts")
}

model ContactGroup {
  id             String    @id @default(uuid()) @db.Char(36)
  organizationId String    @db.Char(36)
  name           String
  description    String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      ContactGroupMember[]

  @@unique([organizationId, name])
  @@map("contact_groups")
}

model ContactGroupMember {
  groupId   String   @db.Char(36)
  contactId String   @db.Char(36)
  addedAt   DateTime @default(now())

  group   ContactGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  contact Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([groupId, contactId])
  @@index([contactId])
  @@map("contact_group_members")
}

model SuppressionEntry {
  id             String            @id @default(uuid()) @db.Char(36)
  organizationId String            @db.Char(36)
  phone          String
  reason         SuppressionReason
  source         String? // "STOP keyword", "manual", "import"...
  note           String?           @db.Text
  createdAt      DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, phone])
  @@map("suppression_entries")
}

// ─────────────────────────────── Messaging ───────────────────────────────

model SenderId {
  id              String         @id @default(uuid()) @db.Char(36)
  organizationId  String         @db.Char(36)
  value           String // "YOURBRAND" (masking) or a number (non-masking)
  type            SenderType
  status          SenderIdStatus @default(PENDING)
  purpose         String?        @db.Text
  sampleMessage   String?        @db.Text
  documents       Json           @default("[]") // [{ key, name, size, contentType }]
  rejectionReason String?        @db.Text
  providerRef     String?        @db.VarChar(255)
  isDefault       Boolean        @default(false)
  submittedById   String?        @db.Char(36)
  reviewedById    String?        @db.Char(36)
  reviewedAt      DateTime?
  approvedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaigns    Campaign[]

  @@unique([organizationId, value])
  @@index([status])
  @@map("sender_ids")
}

model Template {
  id             String    @id @default(uuid()) @db.Char(36)
  organizationId String    @db.Char(36)
  name           String    @db.VarChar(255)
  body           String    @db.Text
  smsType        SmsType   @default(TRANSACTIONAL)
  createdById    String?   @db.Char(36)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaigns    Campaign[]

  @@index([organizationId, name])
  @@map("templates")
}

model Campaign {
  id                 String         @id @default(uuid()) @db.Char(36)
  organizationId     String         @db.Char(36)
  name               String         @db.VarChar(255)
  smsType            SmsType
  senderIdId         String?        @db.Char(36)
  senderValue        String
  senderType         SenderType
  templateId         String?        @db.Char(36)
  message            String         @db.Text
  encoding           SmsEncoding
  segmentsPerMessage Int
  status             CampaignStatus @default(DRAFT)
  // Audience definition: { groupIds: string[], numbers: string[] }
  audience           Json           @default("{}")
  scheduledAt        DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  pausedAt           DateTime?
  cancelledAt        DateTime?
  recipientCount     Int            @default(0)
  skippedCount       Int            @default(0)
  queuedCount        Int            @default(0)
  submittedCount     Int            @default(0)
  deliveredCount     Int            @default(0)
  failedCount        Int            @default(0)
  estimatedCost      Decimal        @default(0) @db.Decimal(14, 4)
  actualCost         Decimal        @default(0) @db.Decimal(14, 4)
  refundedAmount     Decimal        @default(0) @db.Decimal(14, 4)
  failureReason      String?        @db.Text
  reviewNote         String?        @db.Text
  reviewedById       String?        @db.Char(36)
  reviewedAt         DateTime?
  createdById        String?        @db.Char(36)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  deletedAt          DateTime?

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  senderId     SenderId?           @relation(fields: [senderIdId], references: [id])
  template     Template?           @relation(fields: [templateId], references: [id])
  recipients   CampaignRecipient[]
  messages     Message[]

  @@index([organizationId, createdAt])
  @@index([status, scheduledAt])
  @@map("campaigns")
}

model CampaignRecipient {
  id         String          @id @default(uuid()) @db.Char(36)
  campaignId String          @db.Char(36)
  contactId  String?         @db.Char(36)
  phone      String
  variables  Json?
  status     RecipientStatus @default(INCLUDED)
  messageId  String?         @unique @db.Char(36)
  createdAt  DateTime        @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, phone])
  @@index([campaignId, status])
  @@map("campaign_recipients")
}

model Message {
  id                String        @id @default(uuid()) @db.Char(36)
  organizationId    String        @db.Char(36)
  campaignId        String?       @db.Char(36)
  apiKeyId          String?       @db.Char(36)
  source            MessageSource
  to                String // E.164
  operator          String? // prefix-based guess; MNP means this can be wrong
  senderValue       String
  senderType        SenderType
  smsType           SmsType
  body              String        @db.Text
  encoding          SmsEncoding
  segments          Int
  unitPrice         Decimal       @db.Decimal(14, 4)
  cost              Decimal       @db.Decimal(14, 4)
  status            MessageStatus @default(QUEUED)
  provider          String?
  providerMessageId String?       @db.VarChar(255)
  errorCode         String?       @db.VarChar(255)
  errorMessage      String?       @db.Text
  clientReference   String?       @db.VarChar(255)
  attempts          Int           @default(0)
  nextAttemptAt     DateTime?     @default(now())
  lockedUntil       DateTime?
  queuedAt          DateTime      @default(now())
  submittedAt       DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  refundedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     Campaign?      @relation(fields: [campaignId], references: [id])
  apiKey       ApiKey?        @relation(fields: [apiKeyId], references: [id])
  events       MessageEvent[]

  @@unique([provider, providerMessageId])
  @@index([organizationId, createdAt])
  @@index([organizationId, status])
  @@index([status, nextAttemptAt])
  @@index([campaignId, status])
  @@index([to])
  @@map("messages")
}

model MessageEvent {
  id             String             @id @default(uuid()) @db.Char(36)
  messageId      String             @db.Char(36)
  status         MessageStatus
  providerStatus String?            @db.VarChar(255)
  description    String?            @db.Text
  source         MessageEventSource
  dedupeKey      String             @unique @db.VarChar(512)
  payload        Json?
  occurredAt     DateTime
  receivedAt     DateTime           @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, occurredAt])
  @@map("message_events")
}

// ─────────────────────────────── Developer ───────────────────────────────

model ApiKey {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @db.Char(36)
  name           String       @db.VarChar(255)
  prefix         String       @unique // shown in UI, e.g. "sfk_live_a1b2c3d4"
  keyHash        String       @unique // HMAC-SHA256(pepper, fullKey)
  scopes         Json // string[]
  ipAllowlist    Json         @default("[]") // string[]
  status         ApiKeyStatus @default(ACTIVE)
  lastUsedAt     DateTime?
  lastUsedIp     String?
  expiresAt      DateTime?
  createdById    String?      @db.Char(36)
  revokedAt      DateTime?
  revokedById    String?      @db.Char(36)
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages     Message[]
  apiLogs      ApiLog[]

  @@index([organizationId])
  @@map("api_keys")
}

model ApiLog {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String?  @db.Char(36)
  apiKeyId       String?  @db.Char(36)
  requestId      String
  method         String
  path           String   @db.Text
  statusCode     Int
  durationMs     Int
  errorCode      String?
  ipAddress      String?
  userAgent      String?  @db.Text
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  apiKey       ApiKey?       @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([createdAt])
  @@map("api_logs")
}

model IdempotencyKey {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @db.Char(36)
  key            String   @db.VarChar(255)
  requestHash    String
  statusCode     Int?
  response       Json?
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

/// Customer-configured outbound webhook endpoints (delivery reports, campaign events).
model WebhookEndpoint {
  id              String    @id @default(uuid()) @db.Char(36)
  organizationId  String    @db.Char(36)
  url             String    @db.Text
  description     String?   @db.Text
  secretEncrypted String    @db.Text // AES-256-GCM; used to sign payloads
  events          Json // string[]
  active          Boolean   @default(true)
  failureCount    Int       @default(0)
  lastDeliveryAt  DateTime?
  lastStatusCode  Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   WebhookDelivery[]

  @@index([organizationId])
  @@map("webhooks")
}

model WebhookDelivery {
  id             String                @id @default(uuid()) @db.Char(36)
  endpointId     String                @db.Char(36)
  event          String
  payload        Json
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  responseStatus Int?
  responseBody   String?               @db.Text
  nextAttemptAt  DateTime?             @default(now())
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt])
  @@map("webhook_deliveries")
}

/// Raw inbound provider webhooks (SMS delivery reports, payment callbacks), stored for
/// idempotency and debugging.
model InboundWebhookEvent {
  id             String               @id @default(uuid()) @db.Char(36)
  provider       String
  kind           String // "sms.delivery" | "sms.inbound" | "payment"
  eventKey       String               @unique @db.VarChar(512)
  signatureValid Boolean?
  payload        Json
  status         InboundWebhookStatus @default(RECEIVED)
  error          String?              @db.Text
  receivedAt     DateTime             @default(now())
  processedAt    DateTime?

  @@index([provider, receivedAt])
  @@map("inbound_webhook_events")
}

// ─────────────────────────────── Billing ───────────────────────────────

model PricingPlan {
  id                      String   @id @default(uuid()) @db.Char(36)
  key                     String   @unique
  name                    String
  description             String?  @db.Text
  minRechargeAmount       Decimal  @db.Decimal(14, 4)
  transactionalNonMasking Decimal  @db.Decimal(10, 4)
  transactionalMasking    Decimal  @db.Decimal(10, 4)
  promotionalNonMasking   Decimal  @db.Decimal(10, 4)
  promotionalMasking      Decimal  @db.Decimal(10, 4)
  senderIdFee             Decimal  @default(0) @db.Decimal(14, 4)
  features                Json     @default("[]") // string[]
  isCustom                Boolean  @default(false) // "Contact sales" plans
  isPublic                Boolean  @default(true)
  isDefault               Boolean  @default(false)
  active                  Boolean  @default(true)
  highlighted             Boolean  @default(false)
  sortOrder               Int      @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  organizations Organization[]

  @@map("pricing_plans")
}

model CreditPackage {
  id           String   @id @default(uuid()) @db.Char(36)
  name         String
  amount       Decimal  @db.Decimal(14, 4) // BDT paid (before VAT)
  bonusPercent Decimal  @default(0) @db.Decimal(5, 2)
  description  String?  @db.Text
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  payments Payment[]

  @@map("credit_packages")
}

model Wallet {
  id                   String    @id @default(uuid()) @db.Char(36)
  organizationId       String    @unique @db.Char(36)
  balance              Decimal   @default(0) @db.Decimal(14, 4)
  currency             String    @default("BDT")
  lowBalanceThreshold  Decimal   @default(100) @db.Decimal(14, 4)
  lowBalanceNotifiedAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id             String         @id @default(uuid()) @db.Char(36)
  walletId       String         @db.Char(36)
  organizationId String         @db.Char(36)
  type           WalletTxType
  reason         WalletTxReason
  amount         Decimal        @db.Decimal(14, 4) // always positive; type gives direction
  balanceAfter   Decimal        @db.Decimal(14, 4)
  description    String         @db.Text
  referenceType  String? // "payment" | "campaign" | "message" | "api_request" | "admin"
  referenceId    String?        @db.VarChar(255)
  createdById    String?        @db.Char(36)
  createdAt      DateTime       @default(now())

  wallet       Wallet       @relation(fields: [walletId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([reason, referenceType, referenceId])
  @@index([organizationId, createdAt])
  @@map("wallet_transactions")
}

model Payment {
  id              String        @id @default(uuid()) @db.Char(36)
  organizationId  String        @db.Char(36)
  provider        String // "mock" | "manual" | "sslcommerz" ...
  providerRef     String?       @db.VarChar(255) // gateway transaction / validation id
  packageId       String?       @db.Char(36)
  amount          Decimal       @db.Decimal(14, 4) // subtotal before VAT
  vatRate         Decimal       @default(0) @db.Decimal(5, 2)
  vatAmount       Decimal       @default(0) @db.Decimal(14, 4)
  total           Decimal       @db.Decimal(14, 4)
  creditAmount    Decimal       @db.Decimal(14, 4) // BDT added to the wallet (amount + bonus)
  currency        String        @default("BDT")
  status          PaymentStatus @default(PENDING)
  method          String?       @db.VarChar(255) // human-readable, e.g. "Bank transfer"
  manualReference String?       @db.VarChar(255) // customer-submitted reference for manual payments
  metadata        Json          @default("{}")
  failureReason   String?       @db.Text
  initiatedById   String?       @db.Char(36)
  reviewedById    String?       @db.Char(36)
  completedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  package      CreditPackage? @relation(fields: [packageId], references: [id])
  invoice      Invoice?

  @@unique([provider, providerRef])
  @@index([organizationId, createdAt])
  @@index([status])
  @@map("payments")
}

model Invoice {
  id             String        @id @default(uuid()) @db.Char(36)
  organizationId String        @db.Char(36)
  paymentId      String        @unique @db.Char(36)
  number         String        @unique
  subtotal       Decimal       @db.Decimal(14, 4)
  vatRate        Decimal       @db.Decimal(5, 2)
  vatAmount      Decimal       @db.Decimal(14, 4)
  total          Decimal       @db.Decimal(14, 4)
  currency       String        @default("BDT")
  status         InvoiceStatus @default(PAID)
  billingName    String        @db.VarChar(255)
  billingEmail   String?       @db.VarChar(254)
  billingAddress String?       @db.Text
  taxId          String?
  lineItems      Json
  issuedAt       DateTime      @default(now())
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payment      Payment      @relation(fields: [paymentId], references: [id])

  @@index([organizationId, issuedAt])
  @@map("invoices")
}

// ─────────────────────────────── Support ───────────────────────────────

model SupportTicket {
  id             String         @id @default(uuid()) @db.Char(36)
  number         Int            @unique @default(autoincrement())
  organizationId String         @db.Char(36)
  subject        String         @db.VarChar(255)
  category       String
  priority       TicketPriority @default(NORMAL)
  status         TicketStatus   @default(OPEN)
  createdById    String         @db.Char(36)
  assignedToId   String?        @db.Char(36)
  lastReplyAt    DateTime       @default(now())
  closedAt       DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User             @relation("TicketCreator", fields: [createdById], references: [id])
  assignedTo   User?            @relation("TicketAssignee", fields: [assignedToId], references: [id])
  messages     SupportMessage[]

  @@index([organizationId, status])
  @@index([status, lastReplyAt])
  @@map("support_tickets")
}

model SupportMessage {
  id          String   @id @default(uuid()) @db.Char(36)
  ticketId    String   @db.Char(36)
  authorId    String   @db.Char(36)
  body        String   @db.Text
  isStaff     Boolean  @default(false)
  isInternal  Boolean  @default(false) // staff-only notes, never shown to the customer
  attachments Json     @default("[]")
  createdAt   DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id])

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

// ─────────────────────────────── Platform ───────────────────────────────

model AuditLog {
  id             String    @id @default(uuid()) @db.Char(36)
  organizationId String?   @db.Char(36)
  actorType      ActorType
  actorUserId    String?   @db.Char(36)
  actorApiKeyId  String?   @db.Char(36)
  action         String // e.g. "auth.login", "campaign.launch", "pricing.plan.update"
  targetType     String?
  targetId       String?   @db.VarChar(255)
  ipAddress      String?
  userAgent      String?   @db.Text
  metadata       Json      @default("{}")
  createdAt      DateTime  @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id             String    @id @default(uuid()) @db.Char(36)
  organizationId String?   @db.Char(36)
  userId         String    @db.Char(36)
  type           String // "campaign.completed" | "payment.succeeded" | ...
  title          String    @db.VarChar(255)
  body           String    @db.Text
  link           String?   @db.VarChar(500)
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id     String  @id @default(uuid()) @db.Char(36)
  userId String  @db.Char(36)
  type   String
  inApp  Boolean @default(true)
  email  Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("notification_preferences")
}

/// Platform settings (provider config, pricing policy, site content). Secret values are
/// stored encrypted and never sent to the browser.
model Setting {
  key         String   @id
  value       Json
  isSecret    Boolean  @default(false)
  updatedById String?  @db.Char(36)
  updatedAt   DateTime @updatedAt

  @@map("settings")
}

/// Named, gap-free counters (MySQL has no sequences). "invoice_number" numbers invoices.
/// Incremented inside the caller's transaction, see services/billing/payments.ts.
model Counter {
  name  String @id @db.VarChar(64)
  value BigInt

  @@map("counters")
}

model BlocklistEntry {
  id          String        @id @default(uuid()) @db.Char(36)
  type        BlocklistType
  value       String
  reason      String?       @db.Text
  createdById String?       @db.Char(36)
  createdAt   DateTime      @default(now())

  @@unique([type, value])
  @@map("blocklist_entries")
}

model AbuseReport {
  id             String            @id @default(uuid()) @db.Char(36)
  reporterName   String?           @db.VarChar(255)
  reporterEmail  String?           @db.VarChar(254)
  reporterPhone  String?
  senderValue    String
  messageContent String            @db.Text
  receivedAt     DateTime?
  description    String?           @db.Text
  status         AbuseReportStatus @default(NEW)
  organizationId String?           @db.Char(36) // matched sender, if any
  resolutionNote String?           @db.Text
  handledById    String?           @db.Char(36)
  ipAddress      String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([status, createdAt])
  @@map("abuse_reports")
}

/// Contact / sales form submissions from the public website.
model ContactRequest {
  id        String     @id @default(uuid()) @db.Char(36)
  name      String     @db.VarChar(255)
  company   String?    @db.VarChar(255)
  email     String     @db.VarChar(254)
  phone     String?
  subject   String     @db.VarChar(255)
  message   String     @db.Text
  status    LeadStatus @default(NEW)
  ipAddress String?
  createdAt DateTime   @default(now())

  @@index([status, createdAt])
  @@map("contact_requests")
}

model RateLimitBucket {
  key         String
  windowStart DateTime
  count       Int      @default(0)
  expiresAt   DateTime

  @@id([key, windowStart])
  @@index([expiresAt])
  @@map("rate_limit_buckets")
}
