# ─────────────────────────────────────────────────────────────────────────────
# SMSFlow BD - environment configuration
# Copy to .env (local) or configure in your host's secret manager (production).
# NEVER commit real credentials. Every value below is a placeholder.
# ─────────────────────────────────────────────────────────────────────────────

# App
NODE_ENV=development
APP_URL=http://localhost:3000
# Default locale for new visitors: en | bn
DEFAULT_LOCALE=en

# Database (PostgreSQL). `npm run db:local` starts a local server matching this URL.
DATABASE_URL=postgresql://smsflow:smsflow@localhost:54329/smsflow?schema=public
# Used by integration tests only
TEST_DATABASE_URL=postgresql://smsflow:smsflow@localhost:54329/smsflow_test?schema=public

# Security secrets. Generate each with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=replace-with-32+-random-bytes
# Pepper for API key hashing (changing it invalidates all API keys)
API_KEY_PEPPER=replace-with-32+-random-bytes
# 32-byte key (base64) for encrypting provider secrets stored in the database
SETTINGS_ENCRYPTION_KEY=replace-with-base64-32-bytes
# Protects /api/internal/* (worker tick, cron)
CRON_SECRET=replace-with-random-string

# ── SMS provider ─────────────────────────────────────────────────────────────
# mock = local simulator (no messages leave the machine)
# http = generic HTTP gateway adapter (review docs/05-integrations.md before use)
SMS_PROVIDER=mock
SMS_PROVIDER_URL=https://sms-provider.example.com/api
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_API_SECRET=
# Shared secret used to verify delivery-report webhooks from the provider
SMS_PROVIDER_WEBHOOK_SECRET=
# Default non-masking sender used when an organization has no approved sender ID
SMS_DEFAULT_SENDER_ID=8809600000000

# ── Payments ─────────────────────────────────────────────────────────────────
# Comma-separated list of enabled providers: mock, manual, sslcommerz
PAYMENT_PROVIDERS=mock,manual
PAYMENT_PROVIDER_KEY=
PAYMENT_PROVIDER_SECRET=
# SSLCommerz: set true only when using live credentials
PAYMENT_PROVIDER_LIVE=false
# Production builds hide the mock checkout. Set true ONLY for staging/E2E, never on a live site.
ALLOW_MOCK_PAYMENTS=false

# ── Email ────────────────────────────────────────────────────────────────────
# console = write emails to .local/mailbox and the server log (development)
# http    = generic HTTP email API adapter (see docs/05-integrations.md)
EMAIL_PROVIDER=console
EMAIL_PROVIDER_URL=
EMAIL_PROVIDER_KEY=
EMAIL_FROM="SMSFlow BD <no-reply@example.com>"

# ── File storage (sender ID documents, CSV imports) ──────────────────────────
# local = .local/storage on disk (development); s3 = any S3-compatible service
STORAGE_PROVIDER=local
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
# Directory for the local storage driver and the dev mailbox. Use an absolute path (mounted volume) in containers.
LOCAL_DATA_DIR=.local

# ── Feature flags ────────────────────────────────────────────────────────────
FEATURE_PHONE_VERIFICATION=false
FEATURE_REGISTRATION_OPEN=true

# ── Observability ────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Background worker ────────────────────────────────────────────────────────
# true = run the worker loop inside the web server (dev / single instance).
# Production with several instances: false, and run "npm run worker" separately.
WORKER_IN_PROCESS=false
WORKER_INTERVAL_MS=2000
